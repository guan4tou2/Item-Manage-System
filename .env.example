# Database
POSTGRES_DB=ims
POSTGRES_USER=ims
POSTGRES_PASSWORD=ims_change_me
DATABASE_URL=postgresql+asyncpg://ims:ims_change_me@postgres:5432/ims

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# App
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost"]

# Next.js
NEXT_PUBLIC_API_BASE=/api

# AI (Gemini) — leave empty to disable AI suggest endpoint
GEMINI_API_KEY=

# AI 模式（Phase 35）:live = 走真實 Gemini（需 GEMINI_API_KEY）
#                     stub = 走確定性 stub 供應器（測試／離線開發用，不需 key）
# stub 僅允許 ENVIRONMENT=dev；正式環境啟用會直接拒絕啟動。
AI_MODE=live
