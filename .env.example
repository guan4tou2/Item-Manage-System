# Database
POSTGRES_DB=ims
POSTGRES_USER=ims
POSTGRES_PASSWORD=ims_change_me
DATABASE_URL=postgresql+asyncpg://ims:ims_change_me@postgres:5432/ims

# JWT
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# App
ENVIRONMENT=dev
# 日誌格式：json 或 text；留空時 dev 預設 text，其他環境預設 json。
LOG_FORMAT=
# 日誌層級，預設 INFO。
LOG_LEVEL=INFO
# API 文件頁：留空時僅 dev 開啟；true 強制開啟，false 強制關閉。
API_DOCS_ENABLED=
CORS_ORIGINS=["http://localhost"]

# Next.js
NEXT_PUBLIC_API_BASE=/api

# AI (Gemini) — leave empty to disable AI suggest endpoint
GEMINI_API_KEY=
# 使用的 Gemini 模型；舊模型被 Google 停用時改這裡即可（目前可用清單見 https://ai.google.dev/gemini-api/docs/deprecations）
GEMINI_MODEL=gemini-3.6-flash

# AI 模式（Phase 35）:live = 走真實 Gemini（需 GEMINI_API_KEY）
#                     stub = 走確定性 stub 供應器（測試／離線開發用，不需 key）
# stub 僅允許 ENVIRONMENT=dev；正式環境啟用會直接拒絕啟動。
AI_MODE=live

# Webhook 出站預設只允許公網位址（防 SSRF，會擋 localhost／內網／雲端 metadata）。
# 自架且要把 webhook 指向 LAN 服務（例如 Home Assistant、n8n）時才設為 true；
# 開啟後仍只允許 http／https、且不跟隨 redirect。預設 false。
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
